-- ==================== ANTI KNOCKBACK ====================
local function setupAntiKnockback()
    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not getgenv().antiKnockback then 
            connection:Disconnect()
            return 
        end
        
        local char = lp.Character
        if not char then return end
        
        local root = char:FindFirstChild("HumanoidRootPart")
        if root and root.Velocity then
            -- Remove horizontal knockback, keep vertical (jump/fall)
            root.Velocity = Vector3.new(0, root.Velocity.Y, 0)
        end
    end)
end

-- Auto start anti knockback
task.spawn(function()
    while task.wait(1) do
        if getgenv().antiKnockback then
            setupAntiKnockback()
            break
        end
    end
end)

