-- Equip Punch
task.spawn(function()
    while getgenv().autoWinBrawl and task.wait(0.5) do
        equipPunch()
    end
end)

-- Auto Punch
task.spawn(function()
    while getgenv().autoWinBrawl and task.wait(0.1) do
        if isLocalReady() and game.ReplicatedStorage.brawlInProgress.Value then
            pcall(function() lp.muscleEvent:FireServer("punch", "rightHand") end)
            pcall(function() lp.muscleEvent:FireServer("punch", "leftHand") end)
        end
    end
end)

-- Touch Interest (Main Attack)
task.spawn(function()
    while getgenv().autoWinBrawl and task.wait(0.05) do
        if isLocalReady() and game.ReplicatedStorage.brawlInProgress.Value then
            local char = lp.Character
            local left = char:FindFirstChild("LeftHand")
            local right = char:FindFirstChild("RightHand")
            
            for _, plr in pairs(Players:GetPlayers()) do
                if isValidTarget(plr) then
                    local targetRoot = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    if targetRoot then
                        if left then
                            firetouchinterest(targetRoot, left, 0)
                            task.wait(0.01)
                            firetouchinterest(targetRoot, left, 1)
                        end
                        if right then
                            firetouchinterest(targetRoot, right, 0)
                            task.wait(0.01)
                            firetouchinterest(targetRoot, right, 1)
                        end
                    end
                end
            end
        end
    end
end)

-- Anti-Stuck Recovery
task.spawn(function()
    local stuck = 0
    while getgenv().autoWinBrawl and task.wait(1) do
        local count = #Players:GetPlayers()
        if count == stuck then
            stuck += 1
            if stuck > 6 then
                stuck = 0
                pcall(function()
                    local char = lp.Character
                    if char and char:FindFirstChild("Punch") then
                        char.Punch.Parent = lp.Backpack
                        task.wait(0.2)
                    end
                    equipPunch()
                end)
            end
        else
            stuck = count
        end
    end
end)

