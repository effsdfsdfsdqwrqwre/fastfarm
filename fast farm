local packs = window:AddTab("Packs")


packs:AddButton("Swift Samurai", function()
    local player = game:GetService("Players").LocalPlayer
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local equipEvent = ReplicatedStorage.rEvents.equipPetEvent


    if player:FindFirstChild("petsFolder") then
        for _, folder in pairs(player.petsFolder:GetChildren()) do
            if folder:IsA("Folder") then
                for _, pet in pairs(folder:GetChildren()) do
                    equipEvent:FireServer("unequipPet", pet)
                end
            end
        end
    end

    task.wait(0.15)


    local equipped = 0
    if player:FindFirstChild("petsFolder") and player.petsFolder:FindFirstChild("Unique") then
        for _, pet in pairs(player.petsFolder.Unique:GetChildren()) do
            if pet.Name == "Swift Samurai" then
                equipEvent:FireServer("equipPet", pet)
                equipped = equipped + 1
                task.wait(0.05)
            end
        end
    end
end)




