urn end
    pcall(function()
        if typeof(conn) == "RBXScriptConnection" and conn.Disconnect then
            conn:Disconnect()
        elseif type(conn) == "table" and conn.Disconnect then
            conn:Disconnect()
        end
    end)
    connections[name] = nil
end

local function disconnectAll()
    for name, _ in pairs(connections) do
        connections[name] = nil
    end
end

