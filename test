-- ==================== AUTO WIN BRAWL LOGIC (Full) ====================

local Players = game:GetService("Players")
local lp = Players.LocalPlayer

local function equipPunch()
    if not getgenv().autoWinBrawl then return end
    local character = lp.Character
    if not character then return end
    if character:FindFirstChild("Punch") then return true end
    
    local backpack = lp.Backpack
    for _, tool in pairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.Name == "Punch" then
            tool.Parent = character
            return true
        end
    end
end

local function isValidTarget(plr)
    if not plr or plr == lp then return false end
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function isLocalReady()
    local char = lp.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return char:FindFirstChild("LeftHand") or char:FindFirstChild("RightHand")
end

-- Join Brawl
task.spawn(function()
    while getgenv().autoJoinBrawl and task.wait(0.5) do
        if game.Players.LocalPlayer.PlayerGui.gameGui.brawlJoinLabel.Visible then
            game.ReplicatedStorage.rEvents.brawlEvent:FireServer("joinBrawl")
            game.Players.LocalPlayer.PlayerGui.gameGui.brawlJoinLabel.Visible = false
        end
    end
end)

-- Auto Win Brawl Full System
task.spawn(function()
    while getgenv().autoWinBrawl and task.wait(0.5) do
        equipPunch()
    end
end)

task.spawn(function()
    while getgenv().autoWinBrawl and task.wait(0.1) do
        if isLocalReady() and game.ReplicatedStorage.brawlInProgress.Value then
            pcall(function() lp.muscleEvent:FireServer("punch", "rightHand") end)
            pcall(function() lp.muscleEvent:FireServer("punch", "leftHand") end)
        end
    end
end)

task.spawn(function()
    while getgenv().autoWinBrawl and task.wait(0.05) do
        if isLocalReady() and game.ReplicatedStorage.brawlInProgress.Value then
            local char = lp.Character
            local left = char:FindFirstChild("LeftHand")
            local right = char:FindFirstChild("RightHand")
            
            for _, plr in pairs(Players:GetPlayers()) do
                if isValidTarget(plr) then
                    local targetRoot = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    if targetRoot then
                        if left then
                            firetouchinterest(targetRoot, left, 0)
                            task.wait(0.01)
                            firetouchinterest(targetRoot, left, 1)
                        end
                        if right then
                            firetouchinterest(targetRoot, right, 0)
                            task.wait(0.01)
                            firetouchinterest(targetRoot, right, 1)
                        end
                    end
                end
            end
        end
    end
end)

-- Recovery
task.spawn(function()
    local stuck = 0
    while getgenv().autoWinBrawl and task.wait(1) do
        local count = #Players:GetPlayers()
        if count == stuck then
            stuck += 1
            if stuck > 6 then
                stuck = 0
                pcall(function()
                    local char = lp.Character
                    if char and char:FindFirstChild("Punch") then
                        char.Punch.Parent = lp.Backpack
                        task.wait(0.2)
                    end
                    equipPunch()
                end)
            end
        else
            stuck = count
        end
    end
end)

