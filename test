local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "KingTimeGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 70)
frame.Position = UDim2.new(0.5, -130, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0.4, 0)
title.BackgroundTransparency = 1
title.Text = "King Time"
title.Font = Enum.Font.Bangers
title.TextScaled = true
title.TextColor3 = Color3.fromRGB(255, 230, 0)
title.Parent = frame

local timeLabel = Instance.new("TextLabel")
timeLabel.Size = UDim2.new(1, 0, 0.6, 0)
timeLabel.Position = UDim2.new(0, 0, 0.4, 0)
timeLabel.BackgroundTransparency = 1
timeLabel.Font = Enum.Font.Bangers
timeLabel.TextScaled = true
timeLabel.TextColor3 = Color3.new(1, 1, 1)
timeLabel.Parent = frame

-- King Time Counter
local totalKingSeconds = 0
local lastUpdateTime = tick()

-- Function to format seconds into MM:SS or HH:MM:SS
local function formatTime(seconds)
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = math.floor(seconds % 60)
	
	if hours > 0 then
		return string.format("%02d:%02d:%02d", hours, minutes, secs)
	else
		return string.format("%02d:%02d", minutes, secs)
	end
end

-- Update the label
local function updateLabel()
	timeLabel.Text = formatTime(totalKingSeconds)
end

-- Main timer loop (runs every frame but only counts real time)
RunService.Heartbeat:Connect(function()
	local currentTime = tick()
	local delta = currentTime - lastUpdateTime
	lastUpdateTime = currentTime
	
	totalKingSeconds = totalKingSeconds + delta
	
	updateLabel()
end)

-- Initial display
updateLabel()
