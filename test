local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "KingTimeGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 70)
frame.Position = UDim2.new(0.5, -130, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0.4, 0)
title.BackgroundTransparency = 1
title.Text = "King Time"
title.Font = Enum.Font.Bangers
title.TextScaled = true
title.TextColor3 = Color3.fromRGB(255, 230, 0)
title.Parent = frame

local timeLabel = Instance.new("TextLabel")
timeLabel.Size = UDim2.new(1, 0, 0.6, 0)
timeLabel.Position = UDim2.new(0, 0, 0.4, 0)
timeLabel.BackgroundTransparency = 1
timeLabel.Font = Enum.Font.Bangers
timeLabel.TextScaled = true
timeLabel.TextColor3 = Color3.new(1, 1, 1)
timeLabel.Parent = frame

local currentTime = 0
local lastServerValue = -1

local function getKingTime()
    local value = player:FindFirstChild("muscleKingTime")
    if value and value:IsA("IntValue") then
        return value.Value, value
    end

    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            if stat:IsA("IntValue") or stat:IsA("NumberValue") then
                local n = stat.Name:lower()
                if n:find("king") and n:find("time") then
                    return stat.Value, stat
                end
            end
        end
    end

    return 0, nil
end

local _, valueObject = getKingTime()

if valueObject then
    currentTime = valueObject.Value
    lastServerValue = currentTime

    valueObject.Changed:Connect(function(newValue)
        currentTime = newValue
        lastServerValue = newValue
    end)
end

task.spawn(function()
    while true do
        task.wait(1)

        local serverValue, obj = getKingTime()

        if obj and serverValue ~= lastServerValue then
            currentTime = serverValue
            lastServerValue = serverValue
        else
            currentTime += 1
        end

        timeLabel.Text = "Total Seconds: " .. currentTime
    end
end)
