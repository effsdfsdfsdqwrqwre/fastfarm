local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "KingTimeGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 290, 0, 95)
frame.Position = UDim2.new(0.5, -145, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0.3, 0)
title.BackgroundTransparency = 1
title.Text = "👑 Muscle King Time"
title.Font = Enum.Font.GothamBold
title.TextScaled = true
title.TextColor3 = Color3.new(1, 0.85, 0)
title.Parent = frame

local timeLabel = Instance.new("TextLabel")
timeLabel.Size = UDim2.new(1, 0, 0.7, 0)
timeLabel.Position = UDim2.new(0, 0, 0.3, 0)
timeLabel.BackgroundTransparency = 1
timeLabel.Font = Enum.Font.Gotham
timeLabel.TextScaled = true
timeLabel.TextColor3 = Color3.new(1, 1, 1)
timeLabel.Text = "0d 0h 0m 0s"
timeLabel.Parent = frame

local function formatTime(seconds)
    local days = math.floor(seconds / 86400)
    local hours = math.floor((seconds % 86400) / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    
    if days > 0 then
        return string.format("%dd %dh %dm %ds", days, hours, minutes, secs)
    else
        return string.format("%dh %dm %ds", hours, minutes, secs)
    end
end

spawn(function()
    while true do
        local kingTime = 0
        
        -- Main check for Muscle Legends
        if player:FindFirstChild("muscleKingTime") then
            kingTime = player.muscleKingTime.Value
        end
        
        -- Backup checks
        if kingTime == 0 and player:FindFirstChild("leaderstats") then
            local ls = player.leaderstats
            for _, stat in pairs(ls:GetChildren()) do
                local name = string.lower(stat.Name)
                if name:find("king") and (name:find("time") or name:find("timer")) then
                    kingTime = stat.Value
                    break
                end
            end
        end
        
        timeLabel.Text = formatTime(kingTime)
        wait(1)
    end
end)
