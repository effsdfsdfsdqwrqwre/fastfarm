--// Anti Lag (auto starts)
for _, v in ipairs(game:GetDescendants()) do
    if v:IsA("BasePart") and not v:IsA("MeshPart") then
        v.Material = Enum.Material.SmoothPlastic

        if not (
            (v.Parent and v.Parent:FindFirstChild("Humanoid")) or
            (v.Parent and v.Parent.Parent and v.Parent.Parent:FindFirstChild("Humanoid"))
        ) then
            v.Reflectance = 0
        end
    end
end

