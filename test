local function FormatNumber(n)
    n = tonumber(n) or 0
    if n < 1000 then
        return tostring(math.floor(n))
    elseif n < 1e6 then
        return string.format("%.1fk", n / 1e3):gsub("%.0k", "k")
    elseif n < 1e9 then
        return string.format("%.1fm", n / 1e6):gsub("%.0m", "m")
    elseif n < 1e12 then
        return string.format("%.1fb", n / 1e9):gsub("%.0b", "b")
    elseif n < 1e15 then
        return string.format("%.1ft", n / 1e12):gsub("%.0t", "t")
    elseif n < 1e18 then
        return string.format("%.1fqa", n / 1e15):gsub("%.0qa", "qa")
    else
        return string.format("%.1fqi", n / 1e18):gsub("%.0qi", "qi")
    end
end

local function GetStat(player, name)
    local success, value = pcall(function()
        local stats = player:FindFirstChild("leaderstats")
        if stats and stats:FindFirstChild(name) then
            return stats[name].Value
        end
        if player:FindFirstChild(name) then
            return player[name].Value
        end
        local private = player:FindFirstChild("PrivateStats")
        if private and private:FindFirstChild(name) then
            return private[name].Value
        end
        return nil
    end)
    return success and value or nil
end

-- Tries to get total Damage from pets/auras (common locations)
local function GetPetDamage(player)
    local total = 0
    local success = pcall(function()
        -- Common places the game stores equipped pet/aura Damage
        local folders = {
            player:FindFirstChild("Pets"),
            player:FindFirstChild("EquippedPets"),
            player:FindFirstChild("Items"),
            player:FindFirstChild("Inventory"),
            player:FindFirstChild("PrivateStats"),
            player:FindFirstChild("Data"),
        }
        for _, folder in ipairs(folders) do
            if folder then
                for _, obj in ipairs(folder:GetDescendants()) do
                    if obj.Name == "Damage" and (obj:IsA("NumberValue") or obj:IsA("IntValue")) then
                        total = total + (tonumber(obj.Value) or 0)
                    end
                end
            end
        end
    end)
    return success and total or 0
end

