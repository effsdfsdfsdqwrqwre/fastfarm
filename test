local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "KingTimeGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 70)
frame.Position = UDim2.new(0.5, -130, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Parent = gui

Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0.4, 0)
title.BackgroundTransparency = 1
title.Text = "King Time"
title.Font = Enum.Font.Bangers
title.TextScaled = true
title.TextColor3 = Color3.new(1, 0.9, 0)
title.Parent = frame

local timeLabel = Instance.new("TextLabel")
timeLabel.Size = UDim2.new(1, 0, 0.6, 0)
timeLabel.Position = UDim2.new(0, 0, 0.4, 0)
timeLabel.BackgroundTransparency = 1
timeLabel.Font = Enum.Font.Bangers
timeLabel.TextScaled = true
timeLabel.TextColor3 = Color3.new(1, 1, 1)
timeLabel.Parent = frame

local function getKingTime()
    if player:FindFirstChild("muscleKingTime") then
        return player.muscleKingTime.Value
    end

    if player:FindFirstChild("leaderstats") then
        for _, stat in ipairs(player.leaderstats:GetChildren()) do
            local name = stat.Name:lower()
            if name:find("king") and name:find("time") then
                return stat.Value
            end
        end
    end

    return 0
end

local function updateLabel()
    timeLabel.Text = "Total Seconds: " .. getKingTime()
end

-- Update when value changes
local kingTimeValue = player:FindFirstChild("muscleKingTime")
if kingTimeValue then
    kingTimeValue.Changed:Connect(updateLabel)
end

-- Also refresh every second
task.spawn(function()
    while task.wait(1) do
        updateLabel()
    end
end)

updateLabel()
