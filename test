local originalProps = {}

local function saveOriginals(char)
	if originalProps[char] then return end
	originalProps[char] = { parts = {}, humanoid = {} }
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		originalProps[char].humanoid = {
			HipHeight = humanoid.HipHeight,
			WalkSpeed = humanoid.WalkSpeed,
			JumpPower = humanoid.JumpPower,
		}
	end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			originalProps[char].parts[part] = {
				Size = part.Size,
				Transparency = part.Transparency,
				CanCollide = part.CanCollide,
				Massless = part.Massless,
			}
		end
	end
end

local function forceTinyCube(char)
	if not char then return end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then return end

	-- Visible cube (safe size)
	root.Size = Vector3.new(0.5, 0.5, 0.5)
	root.Transparency = 0
	root.CanCollide = true
	root.Massless = false

	local collapseNames = {
		"Head",
		"LeftUpperArm", "LeftLowerArm", "LeftHand",
		"RightUpperArm", "RightLowerArm", "RightHand",
		"LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
		"RightUpperLeg", "RightLowerLeg", "RightFoot",
		"Left Arm", "Right Arm", "Left Leg", "Right Leg"
	}

	for _, name in ipairs(collapseNames) do
		local part = char:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			part.Size = Vector3.new(0.05, 0.05, 0.05)
			part.Transparency = 1
			part.CanCollide = false
			part.Massless = true
			part.CFrame = root.CFrame

			-- Weld without destroying any joints
			local weld = part:FindFirstChild("TinyWeld")
			if not weld then
				weld = Instance.new("WeldConstraint")
				weld.Name = "TinyWeld"
				weld.Part0 = root
				weld.Part1 = part
				weld.Parent = part
			end
		end
	end

	-- Torso almost invisible but keep full joints
	for _, name in ipairs({"UpperTorso", "LowerTorso", "Torso"}) do
		local part = char:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			part.Size = Vector3.new(0.25, 0.25, 0.25)
			part.Transparency = 0.85
			part.CanCollide = false
			part.CFrame = root.CFrame
		end
	end

	-- Accessories
	for _, acc in ipairs(char:GetChildren()) do
		if acc:IsA("Accessory") then
			local handle = acc:FindFirstChild("Handle")
			if handle then
				handle.Size = Vector3.new(0.05, 0.05, 0.05)
				handle.Transparency = 1
				handle.CanCollide = false
				handle.Massless = true
				handle.CFrame = root.CFrame

				local weld = handle:FindFirstChild("TinyWeld")
				if not weld then
					weld = Instance.new("WeldConstraint")
					weld.Name = "TinyWeld"
					weld.Part0 = root
					weld.Part1 = handle
					weld.Parent = handle
				end
			end
		end
	end

	-- Higher HipHeight = no floor clip death
	humanoid.HipHeight = 0.3
	humanoid.WalkSpeed = 25
	humanoid.JumpPower = 40
	workspace.CurrentCamera.CameraSubject = humanoid
end

local function restoreNormal(char)
	if not char or not originalProps[char] then return end
	local data = originalProps[char]
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid and data.humanoid then
		humanoid.HipHeight = data.humanoid.HipHeight
		humanoid.WalkSpeed = data.humanoid.WalkSpeed
		humanoid.JumpPower = data.humanoid.JumpPower
	end
	for part, props in pairs(data.parts) do
		if part and part.Parent then
			part.Size = props.Size
			part.Transparency = props.Transparency
			part.CanCollide = props.CanCollide
			part.Massless = props.Massless
		end
	end
	for _, obj in ipairs(char:GetDescendants()) do
		if obj:IsA("WeldConstraint") and (obj.Name == "TinyWeld" or obj.Name == "ToolRootWeld") then
			obj:Destroy()
		end
	end
	originalProps[char] = nil
	if humanoid then
		workspace.CurrentCamera.CameraSubject = humanoid
	end
end

local function bringToolToRoot(tool, root)
	if not (tool and tool:IsA("Tool") and root) then return end
	local handle = tool:FindFirstChild("Handle")
	if not handle or not handle:IsA("BasePart") then return end

	-- Only clear tool welds (safe)
	for _, w in ipairs(handle:GetChildren()) do
		if w:IsA("Weld") or w:IsA("WeldConstraint") or w:IsA("Motor6D") then
			w:Destroy()
		end
	end

	handle.Size = Vector3.new(0.3, 0.3, 0.3)
	handle.Transparency = 0
	handle.CanCollide = false
	handle.Massless = true
	handle.CFrame = root.CFrame

	local weld = handle:FindFirstChild("ToolRootWeld")
	if not weld then
		weld = Instance.new("WeldConstraint")
		weld.Name = "ToolRootWeld"
		weld.Part0 = root
		weld.Part1 = handle
		weld.Parent = handle
	end
end

