local function UpdateESP()
    for player, data in pairs(ESPObjects) do
        if not player or not player.Parent or not player.Character then
            RemoveESP(player)
            continue
        end

        -- === REAL HEALTH (Durability is the actual HP pool) ===
        local durability = GetStat(player, "Durability")
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if durability then
            local maxHP = durability
            local currentHP = maxHP
            if humanoid and humanoid.MaxHealth > 0 then
                local ratio = humanoid.Health / humanoid.MaxHealth
                if ratio >= 0 and ratio <= 1.05 then
                    currentHP = math.floor(maxHP * ratio)
                end
            end
            data.HealthLabel.Text = "HP: " .. FormatNumber(currentHP) .. " / " .. FormatNumber(maxHP)
        else
            data.HealthLabel.Text = "HP: N/A"
        end

        -- === ACTUAL DAMAGE (Strength / 15 + pet/aura Damage) ===
        local strength = GetStat(player, "Strength")
        if strength then
            local baseDamage = strength / 15
            local petDamage = GetPetDamage(player)
            local totalDamage = baseDamage + petDamage
            data.DamageLabel.Text = "Damage: " .. FormatNumber(totalDamage)
        else
            data.DamageLabel.Text = "Damage: N/A"
        end
    end
end

