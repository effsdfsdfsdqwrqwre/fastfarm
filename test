                local players = game:GetService("Players"):GetPlayers()
                
                if #players <= 1 then
                    task.wait(1)
                    continue
                end
                
                for _, player in ipairs(players) do
                    if player == game.Players.LocalPlayer or not _G.autoKillAll then
                        continue
