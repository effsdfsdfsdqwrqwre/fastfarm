local Players = game:GetService("Players")
local player = Players.LocalPlayer

local library = loadstring(game:HttpGet("https://raw.githubusercontent.com/effsdfsdfsdqwrqwre/fastfarm/refs/heads/main/skullui", true))()

local window = library:AddWindow("INVINCIBLE ┃ PRIVATE FARMING | HELLO, " .. player.DisplayName, {
    main_color = Color3.fromRGB(0, 0, 0),
    min_size = Vector2.new(540, 400),  -- Adjusted height for better fit
    can_resize = false
})

_G.Money = 10000
_G.autokillallgun = false

local MainTab = window:AddTab("Main")

-- Auto Kill All Toggle (using AddSwitch as toggle)
MainTab:AddSwitch("Auto kill All (Gun / disabled and enabled fix bug / (tool rq))", function(v)
    _G.autokillallgun = v
    if _G.autokillallgun then
        local PlayersService = game:GetService("Players")
        local LocalPlayer = PlayersService.LocalPlayer
        
        task.spawn(function()
            while _G.autokillallgun do
                for _, plr in pairs(PlayersService:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                        local rip = Vector3.new(0, 0, 0)

                        local args = {
                            [1] = plr,
                            [2] = rip
                        }

                        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                        if tool and tool:FindFirstChild("kill") then
                            tool.kill:FireServer(unpack(args))
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end)

MainTab:AddButton("Give Knifes/Guns - works on kill all (Gun)", function()
    for _, v in ipairs(game.Players:GetDescendants()) do
        if v:IsA("Tool") then
            v.Parent = game.Players.LocalPlayer.Backpack
        end
    end
end)

MainTab:AddTextBox("Money Value (_G)", function(v)
    _G.Money = tonumber(v) or 10000
end, {clear = true})  -- clear text after input

MainTab:AddButton("Give Money (_G)", function()
    _G.Money = -math.abs(_G.Money)

    local args = {
        [1] = "NiksScythe",
        [2] = _G.Money
    }

    game:GetService("ReplicatedStorage").Buy:InvokeServer(unpack(args))
    task.wait(0.1)
    
    -- Simple notification replacement (library doesn't have built-in MakeNotification, using a label or print)
    print("Money Added: " .. _G.Money .. " (+)")
    -- You can add a Label if you want persistent display
    -- MainTab:AddLabel("Money Added: " .. _G.Money)
end)
