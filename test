        VirtualUser:ClickButton2(Vector2.new())
        statusLabel.Text = "🔄 Roblox tried to kick you... Blocked!"
        task.wait(2)
        statusLabel.Text = "✅ Active - Preventing AFK Kick"
    end)
    table.insert(antiAFKConnections, idledConn)
   
    -- FPS Counter
    local fps = 0
    local fpsConn = RunService.RenderStepped:Connect(function()
        fps += 1
    end)
    table.insert(antiAFKConnections, fpsConn)
   
    task.spawn(function()
        while antiAFKGui and antiAFKGui.Parent do
            fpsLabel.Text = "🚀 FPS: " .. fps
            fps = 0
            task.wait(1)
        end
    end)
   
    -- Timer
    local startTime = tick()
    task.spawn(function()
        while antiAFKGui and antiAFKGui.Parent do
            local elapsed = tick() - startTime
            local hours = math.floor(elapsed / 3600)
            local minutes = math.floor((elapsed % 3600) / 60)
            local seconds = math.floor(elapsed % 60)
            timeLabel.Text = string.format("⏳ Time: %02d:%02d:%02d", hours, minutes, seconds)
            task.wait(0.5)
        end
    end)
   
    -- Ping (simulated)
    task.spawn(function()
        while antiAFKGui and antiAFKGui.Parent do
            local ping = math.random(25, 75)
            msLabel.Text = "📡 MS: " .. ping
            task.wait(2)
        end
    end)
   
    print("Invincible Anti-AFK GUI Enabled")
end

local function destroyAntiAFKGui()
    if antiAFKGui then
        antiAFKGui:Destroy()
        antiAFKGui = nil
    end
    for _, conn in ipairs(antiAFKConnections) do
        if conn then conn:Disconnect() end
    end
    antiAFKConnections = {}
    print("Invincible Anti-AFK GUI Disabled")
end

