-- Simple Black Box Brawls Counter
-- Paste this LocalScript in StarterPlayerScripts

local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BrawlsBox"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- Main Black Box
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 180, 0, 55)
frame.Position = UDim2.new(0.5, -90, 0, 70)  -- Under strength/gems - change if needed
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.BackgroundTransparency = 0.25
frame.BorderSizePixel = 0
frame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

-- Black Stroke / Border
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(0, 0, 0)
stroke.Thickness = 3
stroke.Transparency = 0.1
stroke.Parent = frame

-- Label
local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, -20, 1, 0)
label.Position = UDim2.new(0, 10, 0, 0)
label.BackgroundTransparency = 1
label.Text = "Brawls: 0"
label.TextColor3 = Color3.fromRGB(255, 255, 255)
label.TextScaled = true
label.Font = Enum.Font.GothamBold
label.Parent = frame

-- Draggable
local dragging = false
local dragInput
local dragStart
local startPos

frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)

frame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if dragging and input == dragInput then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- Update
spawn(function()
	while wait(1.5) do
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			local brawls = leaderstats:FindFirstChild("BrawlWins") 
				or leaderstats:FindFirstChild("Brawls") 
				or leaderstats:FindFirstChild("Wins")
				or leaderstats:FindFirstChild("BrawlCount")
			
			if brawls then
				label.Text = "Brawls: " .. tostring(brawls.Value)
			else
				label.Text = "Brawls: ?"
			end
		end
	end
end)
