spawn(function()
    while wait(1) do
        local totalKingTime = 0
        if player:FindFirstChild("leaderstats") then
            local ls = player.leaderstats
            if ls:FindFirstChild("KingTime") then
                totalKingTime = ls.KingTime.Value
            elseif ls:FindFirstChild("King Time") then
                totalKingTime = ls["King Time"].Value
            elseif ls:FindFirstChild("MuscleKingTime") then
                totalKingTime = ls.MuscleKingTime.Value
            elseif ls:FindFirstChild("TotalKingTime") then
                totalKingTime = ls.TotalKingTime.Value
            end
        end
        if totalKingTime == 0 then
            for _, v in ipairs(player:GetDescendants()) do
                if (v:IsA("IntValue") or v:IsA("NumberValue")) then
                    local name = v.Name:lower()
                    if name:find("king") and name:find("time") then
                        totalKingTime = v.Value
                        break
                    end
                end
            end
        end
        timeLabel.Text = tostring(math.floor(totalKingTime))
    end
end)

