local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "KingTimeGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 70)
frame.Position = UDim2.new(0.5, -130, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0.4, 0)
title.BackgroundTransparency = 1
title.Text = "King Time"
title.Font = Enum.Font.Bangers
title.TextScaled = true
title.TextColor3 = Color3.new(1, 0.9, 0)
title.Parent = frame

local timeLabel = Instance.new("TextLabel")
timeLabel.Size = UDim2.new(1, 0, 0.6, 0)
timeLabel.Position = UDim2.new(0, 0, 0.4, 0)
timeLabel.BackgroundTransparency = 1
timeLabel.Font = Enum.Font.Bangers
timeLabel.TextScaled = true
timeLabel.TextColor3 = Color3.new(1, 1, 1)
timeLabel.Text = "Total Seconds: 0"
timeLabel.Parent = frame

-- Better timer logic
local lastServerValue = 0
local lastSyncTime = tick()

spawn(function()
	while true do
		-- Try to get the value from the main Value object
		if player:FindFirstChild("muscleKingTime") then
			lastServerValue = player.muscleKingTime.Value
			lastSyncTime = tick()
		else
			-- Backup: look in leaderstats
			if player:FindFirstChild("leaderstats") then
				local ls = player.leaderstats
				for _, stat in pairs(ls:GetChildren()) do
					local name = string.lower(stat.Name)
					if name:find("king") and name:find("time") then
						lastServerValue = stat.Value
						lastSyncTime = tick()
						break
					end
				end
			end
		end
		
		task.wait(5) -- Sync with server every 5 seconds (good balance)
	end
end)

-- Main display loop - updates every frame for smoothness
RunService.RenderStepped:Connect(function()
	local elapsed = tick() - lastSyncTime
	local displayedTime = math.floor(lastServerValue + elapsed)
	
	timeLabel.Text = "Total Seconds: " .. displayedTime
end)
