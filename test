Killer:AddSwitch("Anti Fling", function(state)
    getgenv().RemoveKnockback = state

    if state then
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local LP = Players.LocalPlayer

        local function ApplyAntiKnockback(char)
            if not char then return end
            local hrp = char:WaitForChild("HumanoidRootPart", 5)
            local hum = char:WaitForChild("Humanoid", 5)
            if not hrp or not hum then return end

            -- Destroy any BodyVelocity / LinearVelocity the game applies for knockback
            local function CleanForces()
                for _, v in pairs(hrp:GetChildren()) do
                    if v:IsA("BodyVelocity") or v:IsA("BodyForce") or v:IsA("LinearVelocity") or v:IsA("VectorForce") then
                        v:Destroy()
                    end
                end
            end

            -- Main loop – only cancels high horizontal velocity (knockback)
            local conn
            conn = RunService.Heartbeat:Connect(function()
                if not getgenv().RemoveKnockback or not char.Parent or not hrp.Parent then
                    if conn then conn:Disconnect() end
                    return
                end

                CleanForces()

                local vel = hrp.AssemblyLinearVelocity
                local horizontal = Vector3.new(vel.X, 0, vel.Z)
                local speed = horizontal.Magnitude

                -- Only cancel if it's clearly knockback (high speed) and player is not intentionally moving fast
                if speed > 45 and hum.MoveDirection.Magnitude < 0.1 then
                    hrp.AssemblyLinearVelocity = Vector3.new(0, vel.Y, 0) -- keep vertical (jump/fall)
                end
            end)
        end

        -- Apply on current character + future respawns
        if LP.Character then
            ApplyAntiKnockback(LP.Character)
        end
        LP.CharacterAdded:Connect(ApplyAntiKnockback)
    end
end)


