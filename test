-- Muscle Legends - Auto Brawl + Teleport to Enemies + Auto Punch
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- === GUI (same clean one) ===
local gui = Instance.new("ScreenGui")
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 300, 0, 380)
frame.Position = UDim2.new(0.5, -150, 0.5, -190)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 50)
title.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
title.Text = "Muscle Legends Brawl Killer"
title.TextColor3 = Color3.new(1,1,1)
title.TextScaled = true
title.Font = Enum.Font.GothamBold
title.Parent = frame

-- Draggable
title.InputBegan:Connect(function(inp) 
    if inp.UserInputType == Enum.UserInputType.MouseButton1 then
        local dragStart = inp.Position
        local startPos = frame.Position
        local conn
        conn = RunService.RenderStepped:Connect(function()
            local delta = inp.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end)
        inp.Changed:Connect(function()
            if inp.UserInputState == Enum.UserInputState.End then conn:Disconnect() end
        end)
    end
end)

local y = 60
local function addToggle(name, default, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 45)
    btn.Position = UDim2.new(0.05, 0, 0, y)
    btn.BackgroundColor3 = default and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(60, 60, 60)
    btn.Text = name .. ": " .. (default and "ON" or "OFF")
    btn.TextColor3 = Color3.new(1,1,1)
    btn.TextScaled = true
    btn.Font = Enum.Font.Gotham
    btn.Parent = frame
    
    local enabled = default
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        btn.Text = name .. ": " .. (enabled and "ON" or "OFF")
        btn.BackgroundColor3 = enabled and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(60, 60, 60)
        callback(enabled)
    end)
    y = y + 55
end

-- Variables
local autoJoin = false
local autoTeleport = false
local autoPunch = false

-- Auto Join Brawl
addToggle("Auto Join Brawl", false, function(state) autoJoin = state end)

-- Teleport to Players in Brawl + Auto Punch
addToggle("Teleport + Auto Punch", false, function(state)
    autoTeleport = state
    autoPunch = state
end)

-- Main Loop
RunService.Heartbeat:Connect(function()
    if not (autoTeleport or autoPunch) then return end
    
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local root = character.HumanoidRootPart
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = p.Character.HumanoidRootPart
            local distance = (root.Position - targetRoot.Position).Magnitude
            
            -- Teleport close to them
            if autoTeleport and distance > 8 and distance < 200 then
                root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 6)  -- behind them
            end
            
            -- Auto Punch
            if autoPunch then
                for _, v in ipairs(character:GetDescendants()) do
                    if v:IsA("RemoteEvent") and (v.Name:lower():find("punch") or v.Name:lower():find("attack") or v.Name:lower():find("hit")) then
                        pcall(function() v:FireServer() end)
                    end
                end
            end
        end
    end
end)

-- Auto Join Loop
spawn(function()
    while wait(4) do
        if autoJoin then
            for _, v in ipairs(game:GetDescendants()) do
                if v:IsA("RemoteEvent") and (v.Name:lower():find("brawl") or v.Name:lower():find("join") or v.Name:lower():find("arena")) then
                    pcall(function() v:FireServer() end)
                end
            end
        end
    end
end)

print("✅ Muscle Legends Brawl Killer loaded! Use the toggles.")
