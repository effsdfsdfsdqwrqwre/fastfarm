local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "KingTimeGUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 250, 0, 70)
frame.Position = UDim2.new(0.5, -125, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0.4, 0)
title.BackgroundTransparency = 1
title.Text = "👑 Muscle King Time"
title.Font = Enum.Font.GothamBold
title.TextScaled = true
title.TextColor3 = Color3.new(1, 1, 0)
title.Parent = frame

local timeLabel = Instance.new("TextLabel")
timeLabel.Size = UDim2.new(1, 0, 0.6, 0)
timeLabel.Position = UDim2.new(0, 0, 0.4, 0)
timeLabel.BackgroundTransparency = 1
timeLabel.Font = Enum.Font.Gotham
timeLabel.TextScaled = true
timeLabel.TextColor3 = Color3.new(1, 1, 1)
timeLabel.Text = "Total King Time: 0h 0m 0s"
timeLabel.Parent = frame

-- Main update loop
local function formatTime(seconds)
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    return string.format("Total King Time: %dh %dm %ds", hours, minutes, secs)
end

spawn(function()
    while true do
        local kingTime = 0
        
        -- Try common leaderstat paths used in Muscle Legends
        if player:FindFirstChild("leaderstats") then
            local ls = player.leaderstats
            
            -- Most common possibilities:
            if ls:FindFirstChild("KingTime") then
                kingTime = ls.KingTime.Value
            elseif ls:FindFirstChild("King Time") then
                kingTime = ls["King Time"].Value
            elseif ls:FindFirstChild("TimeAsKing") then
                kingTime = ls.TimeAsKing.Value
            elseif ls:FindFirstChild("MuscleKingTime") then
                kingTime = ls.MuscleKingTime.Value
            end
        end
        
        -- Fallback: check directly on player if it's a Value
        if kingTime == 0 then
            if player:FindFirstChild("KingTime") then
                kingTime = player.KingTime.Value
            end
        end
        
        timeLabel.Text = formatTime(kingTime)
        wait(1) -- update every second
    end
end)
