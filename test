-- Recovery
task.spawn(function()
    local stuck = 0
    while getgenv().autoWinBrawl and task.wait(1) do
        local count = #Players:GetPlayers()
        if count == stuck then
            stuck += 1
            if stuck > 6 then
                stuck = 0
                pcall(function()
                    local char = lp.Character
                    if char and char:FindFirstChild("Punch") then
                        char.Punch.Parent = lp.Backpack
                        task.wait(0.2)
                    end
                    equipPunch()
                end)
            end
        else
            stuck = count
        end
    end
end)


