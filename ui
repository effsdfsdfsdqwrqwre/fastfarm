			contentArea.Visible = false
			tabContainer.Visible = false
		else
			Tween(main, {Size = window.OriginalSize}, 0.3)
			contentArea.Visible = true
			tabContainer.Visible = true
		end
	end)

	tabList.ChildAdded:Connect(function()
		task.defer(function()
			tabList.CanvasSize = UDim2.new(0, 0, 0, tabList.UIListLayout.AbsoluteContentSize.Y + 10)
		end)
	end)

	function window:SelectTab(name)
		for _, tab in ipairs(self.Tabs) do
			if tab.Name == name then
				tab.Content.Visible = true
				Tween(tab.Button, {BackgroundColor3 = theme.Accent, TextColor3 = Color3.new(1,1,1)}, 0.2)
				self.CurrentTab = tab
			else
				tab.Content.Visible = false
				Tween(tab.Button, {BackgroundColor3 = theme.Tertiary, TextColor3 = theme.TextDim}, 0.2)
			end
		end
	end

	function window:CreateTab(name, icon)
		local tabButton = Create("TextButton", {
			BackgroundColor3 = theme.Tertiary,
			Size = UDim2.new(1, 0, 0, 36),
			Font = FemboyUI.Config.Font,
			Text = "  " .. (icon or "") .. "  " .. name,
			TextColor3 = theme.TextDim,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			Parent = self.TabList
		})
		ApplyCorner(tabButton, 6)

		local tabContent = Create("ScrollingFrame", {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			CanvasSize = UDim2.new(0, 0, 0, 0),
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = theme.Border,
			BorderSizePixel = 0,
			Visible = false,
			Parent = self.ContentArea
		})
		local list = ApplyListLayout(tabContent, 6)
		ApplyPadding(tabContent, 4, 12, 4, 8)

		local tabData = {Name = name, Button = tabButton, Content = tabContent}
		table.insert(self.Tabs, tabData)

		tabButton.MouseButton1Click:Connect(function() self:SelectTab(name) end)
		tabButton.MouseEnter:Connect(function()
			if self.CurrentTab ~= tabData then Tween(tabButton, {BackgroundColor3 = theme.Secondary}, 0.15) end
		end)
		tabButton.MouseLeave:Connect(function()
			if self.CurrentTab ~= tabData then Tween(tabButton, {BackgroundColor3 = theme.Tertiary}, 0.15) end
		end)

		if #self.Tabs == 1 then self:SelectTab(name) end

		list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			tabContent.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 20)
		end)

		local tabObj = {Name = name, Content = tabContent, Window = self}

		function tabObj:CreateSection(sectionName)
			local section = Create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 26),
				Parent = self.Content
			})
			Create("TextLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, 0),
				Font = FemboyUI.Config.FontBold,
				Text = sectionName,
				TextColor3 = theme.Text,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = section
			})
			Create("Frame", {
				BackgroundColor3 = theme.Border,
				Position = UDim2.new(0, 0, 1, -1),
				Size = UDim2.new(1, 0, 0, 1),
				BorderSizePixel = 0,
				Parent = section
			})
			return section
		end

		function tabObj:CreateButton(opts)
			opts = opts or {}
			local callback = opts.Callback or function() end

			local button = Create("TextButton", {
				BackgroundColor3 = theme.Tertiary,
				Size = UDim2.new(1, 0, 0, 28),
				Font = FemboyUI.Config.Font,
				Text = opts.Name or "Button",
				TextColor3 = theme.Text,
