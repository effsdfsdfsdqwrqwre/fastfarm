				Position = UDim2.new(1, -26, 0, 0),
				Size = UDim2.fromOffset(22, 28),
				Font = FemboyUI.Config.FontBold,
				Text = "▾",
				TextColor3 = theme.TextDim,
				TextSize = 13,
				Parent = container
			})

			local dropFrame = Create("Frame", {
				BackgroundColor3 = theme.Secondary,
				Position = UDim2.new(0, 0, 1, 3),
				Size = UDim2.new(1, 0, 0, 0),
				BorderSizePixel = 0,
				ClipsDescendants = true,
				Visible = false,
				ZIndex = 50,
				Parent = container
			})
			ApplyCorner(dropFrame, 5)
			ApplyStroke(dropFrame, theme.Border, 1)

			local dropList = Create("ScrollingFrame", {
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				CanvasSize = UDim2.new(0, 0, 0, 0),
				ScrollBarThickness = 3,
				BorderSizePixel = 0,
				Parent = dropFrame
			})
			ApplyListLayout(dropList, 2)
			ApplyPadding(dropList, 3, 3, 3, 3)

			local open = false
			local function toggle()
				open = not open
				dropFrame.Visible = true
				local h = math.min(#list * 26 + 8, 140)
				Tween(dropFrame, {Size = UDim2.new(1, 0, 0, open and h or 0)}, 0.18)
				Tween(arrow, {Rotation = open and 180 or 0}, 0.18)
				if not open then
					task.delay(0.2, function()
						if not open then dropFrame.Visible = false end
					end)
				end
			end

			for _, option in ipairs(list) do
				local btn = Create("TextButton", {
					BackgroundColor3 = theme.Tertiary,
					Size = UDim2.new(1, 0, 0, 24),
					Font = FemboyUI.Config.Font,
					Text = "  " .. option,
					TextColor3 = theme.Text,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					AutoButtonColor = false,
					Parent = dropList
				})
				ApplyCorner(btn, 4)

				btn.MouseEnter:Connect(function()
					Tween(btn, {BackgroundColor3 = theme.Accent}, 0.12)
				end)
				btn.MouseLeave:Connect(function()
					Tween(btn, {BackgroundColor3 = theme.Tertiary}, 0.12)
				end)
				btn.MouseButton1Click:Connect(function()
					selected = option
					label.Text = name .. ": " .. tostring(selected)
					toggle()
					task.spawn(callback, selected)
				end)
			end
			dropList.CanvasSize = UDim2.new(0, 0, 0, #list * 26 + 8)

			container.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					toggle()
				end
			end)

			return {
				Get = function() return selected end,
				Set = function(_, v)
					selected = v
					label.Text = name .. ": " .. tostring(selected)
				end
			}
		end

		function tabObj:CreateSlider(opts)
			opts = opts or {}
			local min, max = opts.Min or 0, opts.Max or 100
			local value = math.clamp(opts.Default or min, min, max)
			local increment = opts.Increment or 1
			local suffix = opts.Suffix or ""
			local callback = opts.Callback or function() end

			local container = Create("Frame", {
				BackgroundColor3 = theme.Tertiary,
				Size = UDim2.new(1, 0, 0, 48),
				BorderSizePixel = 0,
				Parent = self.Content
			})
			ApplyCorner(container, 5)
			ApplyStroke(container, theme.Border, 1)

			Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(10, 5),
				Size = UDim2.new(0.6, 0, 0, 16),
				Font = FemboyUI.Config.Font,
				Text = opts.Name or "Slider",
				TextColor3 = theme.Text,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = container
			})

			local valueLabel = Create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0.6, 0, 0, 5),
				Size = UDim2.new(0.4, -10, 0, 16),
				Font = FemboyUI.Config.Font,
				Text = tostring(value) .. suffix,
				TextColor3 = theme.TextDim,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = container
			})

			local track = Create("Frame", {
				BackgroundColor3 = theme.SliderTrack,
				Position = UDim2.fromOffset(10, 30),
				Size = UDim2.new(1, -20, 0, 5),
				BorderSizePixel = 0,
				Parent = container
			})
			ApplyCorner(track, 3)

			local fill = Create("Frame", {
				BackgroundColor3 = theme.SliderFill,
				Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
				BorderSizePixel = 0,
				Parent = track
			})
			ApplyCorner(fill, 3)

			local knob = Create("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
				Size = UDim2.fromOffset(12, 12),
				BorderSizePixel = 0,
				ZIndex = 2,
				Parent = track
			})
			ApplyCorner(knob, 6)

			local dragging = false
			local function update(pos)
				local rel = math.clamp((pos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				value = math.clamp(math.floor((min + (max - min) * rel) / increment + 0.5) * increment, min, max)
				local pct = (value - min) / (max - min)
				fill.Size = UDim2.new(pct, 0, 1, 0)
				knob.Position = UDim2.new(pct, 0, 0.5, 0)
				valueLabel.Text = tostring(value) .. suffix
				task.spawn(callback, value)
			end

			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					update(input.Position)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					update(input.Position)
				end
			end)

			return {
				Set = function(_, v)
					value = math.clamp(v, min, max)
					local pct = (value - min) / (max - min)
					fill.Size = UDim2.new(pct, 0, 1, 0)
					knob.Position = UDim2.new(pct, 0, 0.5, 0)
					valueLabel.Text = tostring(value) .. suffix
					task.spawn(callback, value)
				end,
				Get = function() return value end
			}
		end

		function tabObj:CreateLabel(opts)
			opts = opts or {}
			return Create("TextLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 20),
				Font = FemboyUI.Config.Font,
				Text = opts.Text or "Label",
				TextColor3 = theme.TextDim,
				TextSize = opts.TextSize or 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true,
				Parent = self.Content
			})
		end

		function tabObj:CreateDivider()
			return Create("Frame", {
				BackgroundColor3 = theme.Border,
				Size = UDim2.new(1, 0, 0, 1),
				BorderSizePixel = 0,
				Parent = self.Content
			})
		end

		return tabObj
	end

	return window
end

FemboyUI.CreateWindow = CreateWindow

local Window = CreateWindow({
	Title = "Femboy UI ♡",
	Size = UDim2.fromOffset(560, 420),
	Theme = "Femboy" 
})
