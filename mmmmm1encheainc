-- Main Variables
local espEnabled = false
local roleESP = false
local godmode = false
local killAura = false
local silentAim = false
local autoCollect = false
local speedHack = false
local jumpPower = 50
local currentSpeed = 16

local murderer = nil
local sheriff = nil

-- Helper Functions
local function getRoles()
    murderer = nil
    sheriff = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if char then
                local knife = char:FindFirstChild("Knife")
                local gun = char:FindFirstChild("Gun")
                if knife then murderer = plr end
                if gun then sheriff = plr end
            end
        end
    end
end

local function createESP(plr, color, text)
    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
        local highlight = Instance.new("Highlight")
        highlight.Adornee = plr.Character
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.Parent = plr.Character
        
        local billboard = Instance.new("BillboardGui")
        billboard.Adornee = plr.Character.HumanoidRootPart
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = text .. " [" .. plr.Name .. "]"
        label.TextColor3 = color
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold
        label.Parent = billboard
        
        billboard.Parent = plr.Character
    end
end

local function updateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            for _, v in ipairs(plr.Character:GetChildren()) do
                if v:IsA("Highlight") or v:IsA("BillboardGui") then
                    v:Destroy()
                end
            end
        end
    end
    
    if not espEnabled then return end
    
    getRoles()
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local color = Color3.fromRGB(255, 255, 255)
            local label = "Innocent"
            
            if plr == murderer then
                color = Color3.fromRGB(255, 0, 0)
                label = "Murderer"
            elseif plr == sheriff then
                color = Color3.fromRGB(0, 100, 255)
                label = "Sheriff"
            end
            
            createESP(plr, color, label)
        end
    end
end

