tabMisc:AddButton("Rejoin", function()
    game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
end)

-- Main Loop
RunService.Heartbeat:Connect(function()
    local character = player.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")
    if not root or not humanoid then return end

    -- Godmode
    if godmode then
        humanoid.MaxHealth = math.huge
        humanoid.Health = math.huge
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    end

    -- Speed Hack
    if speedHack then
        humanoid.WalkSpeed = currentSpeed
    else
        humanoid.WalkSpeed = 16
    end

    -- Fly
    if flyEnabled and flyBodyVelocity and flyBodyGyro then
        local moveDir = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += root.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= root.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= root.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += root.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0,1,0) end

        local velocity = moveDir.Magnitude > 0 and moveDir.Unit * flySpeed or Vector3.new()
        flyBodyVelocity.Velocity = velocity
        flyBodyGyro.CFrame = root.CFrame
    end

    -- NoClip
    if noclipEnabled then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end

    -- Auto Collect
    if autoCollect then
        for _, coin in ipairs(Workspace:GetDescendants()) do
            if (coin.Name:find("Coin") or coin.Name:find("coin")) and coin:IsA("BasePart") then
                if (coin.Position - root.Position).Magnitude < 40 then
                    firetouchinterest(root, coin, 0)
                end
            end
        end
    end

    -- Kill Aura
    if killAura and (player.Backpack:FindFirstChild("Knife") or character:FindFirstChild("Knife")) then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (plr.Character.HumanoidRootPart.Position - root.Position).Magnitude
                if dist < 15 then
                    root.CFrame = plr.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -4)
                end
            end
        end
    end
end)

-- ESP Loop
task.spawn(function()
    while true do
        task.wait(1)
        if espEnabled then
            updateESP()
        end
        getRoles()
    end
end)

task.wait(0.5)
print("✅ INVINCIBLE MM2 Script Loaded Successfully! (All features as Buttons/Switches)")
pcall(function() window:Show() end)
