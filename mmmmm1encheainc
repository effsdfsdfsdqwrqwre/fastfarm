-- Main Loops
RunService.Heartbeat:Connect(function()
    if godmode and player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.Health = player.Character.Humanoid.MaxHealth
    end
    
    if speedHack and player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.WalkSpeed = currentSpeed
    end
    
    if autoCollect then
        for _, coin in ipairs(Workspace:GetDescendants()) do
            if coin.Name:find("Coin") and coin:IsA("BasePart") and (coin.Position - player.Character.HumanoidRootPart.Position).Magnitude < 50 then
                firetouchinterest(player.Character.HumanoidRootPart, coin, 0)
                task.wait(0.05)
            end
        end
    end
    
    if killAura and player.Character and (player.Backpack:FindFirstChild("Knife") or player.Character:FindFirstChild("Knife")) then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (plr.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if dist < 15 then
                    player.Character.HumanoidRootPart.CFrame = plr.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -2)
                end
            end
        end
    end
end)

-- ESP Loop
spawn(function()
    while task.wait(1) do
        if espEnabled then
            updateESP()
        end
        getRoles()
    end
end)

-- Silent Aim (basic)
local mt = getrawmetatable(game)
local old = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    if silentAim and method == "FireServer" and self.Name == "ShootGun" then
        getRoles()
        if murderer and murderer.Character then
            args[1] = murderer.Character.HumanoidRootPart.Position
        end
    end
    
    return old(self, unpack(args))
end)

setreadonly(mt, true)

