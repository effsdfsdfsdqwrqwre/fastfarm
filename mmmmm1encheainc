local Players = game:GetService("Players")
local player = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

-- Load UI Library
local library = loadstring(game:HttpGet("https://raw.githubusercontent.com/effsdfsdfsdqwrqwre/fastfarm/refs/heads/main/skullui", true))()
local window = library:AddWindow("INVINCIBLE ┃ MM2 | HELLO, " .. player.DisplayName, {
    main_color = Color3.fromRGB(255, 0, 100),
    min_size = Vector2.new(540, 680),
    can_resize = true
})

-- Variables
local espEnabled = false
local godmode = false
local killAura = false
local silentAim = false
local autoCollect = false
local speedHack = false
local flyEnabled = false
local noclipEnabled = false

local currentSpeed = 50
local flySpeed = 50
local flyBodyVelocity = nil
local flyBodyGyro = nil

local murderer = nil
local sheriff = nil

-- Helper Functions
local function getRoles()
    murderer = nil
    sheriff = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            if char then
                if char:FindFirstChild("Knife") then murderer = plr end
                if char:FindFirstChild("Gun") then sheriff = plr end
            end
        end
    end
end

local function createESP(plr, color, text)
    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
        local highlight = Instance.new("Highlight")
        highlight.Adornee = plr.Character
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.Parent = plr.Character
        
        local billboard = Instance.new("BillboardGui")
        billboard.Adornee = plr.Character.HumanoidRootPart
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = text .. " [" .. plr.Name .. "]"
        label.TextColor3 = color
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold
        label.Parent = billboard
        
        billboard.Parent = plr.Character
    end
end

local function updateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            for _, v in ipairs(plr.Character:GetChildren()) do
                if v:IsA("Highlight") or v:IsA("BillboardGui") then
                    v:Destroy()
                end
            end
        end
    end
    if not espEnabled then return end
    getRoles()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local color = Color3.fromRGB(255, 255, 255)
            local label = "Innocent"
            if plr == murderer then
                color = Color3.fromRGB(255, 0, 0)
                label = "Murderer"
            elseif plr == sheriff then
                color = Color3.fromRGB(0, 100, 255)
                label = "Sheriff"
            end
            createESP(plr, color, label)
        end
    end
end

-- Fly Functions
local function StartFly()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local root = character.HumanoidRootPart
    local humanoid = character:FindFirstChild("Humanoid")
    
    if flyBodyVelocity then flyBodyVelocity:Destroy() end
    if flyBodyGyro then flyBodyGyro:Destroy() end

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyBodyVelocity.Velocity = Vector3.new(0,0,0)
    flyBodyVelocity.Parent = root

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyBodyGyro.P = 10000
    flyBodyGyro.D = 500
    flyBodyGyro.Parent = root

    if humanoid then humanoid.PlatformStand = true end
end

local function EndFly()
    local character = player.Character
    if character and character:FindFirstChild("Humanoid") then
        character.Humanoid.PlatformStand = false
    end
    if flyBodyVelocity then flyBodyVelocity:Destroy() end
    if flyBodyGyro then flyBodyGyro:Destroy() end
end

