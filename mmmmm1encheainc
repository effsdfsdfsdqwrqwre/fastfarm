local Players = game:GetService("Players")
local player = Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

-- Load UI Library
local library = loadstring(game:HttpGet("https://raw.githubusercontent.com/effsdfsdfsdqwrqwre/fastfarm/refs/heads/main/skullui", true))()

-- Create Window
local window = library:AddWindow("INVINCIBLE ┃ MM2 | " .. player.DisplayName, {
    main_color = Color3.fromRGB(255, 0, 100),
    min_size = Vector2.new(540, 680),
    can_resize = true,
    toggle_key = Enum.KeyCode.RightShift
})

-- Variables
local espEnabled = false
local godmode = false
local killAura = false
local silentAim = false
local autoCollect = false
local speedHack = false
local flyEnabled = false
local noclipEnabled = false

local currentSpeed = 50
local flySpeed = 50

local flyBodyVelocity = nil
local flyBodyGyro = nil

local murderer = nil
local sheriff = nil

-- Wait for character
if not player.Character then
    player.CharacterAdded:Wait()
end

-- Helper Functions
local function getRoles()
    murderer = nil
    sheriff = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local char = plr.Character
            if char:FindFirstChild("Knife") or char:FindFirstChild("knife") then
                murderer = plr
            end
            if char:FindFirstChild("Gun") or char:FindFirstChild("gun") then
                sheriff = plr
            end
        end
    end
end

local function createESP(plr, color, text)
    if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then return end
    
    -- Clean old ESP
    for _, v in ipairs(plr.Character:GetChildren()) do
        if v:IsA("Highlight") or v:IsA("BillboardGui") then
            v:Destroy()
        end
    end

    local highlight = Instance.new("Highlight")
    highlight.Adornee = plr.Character
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = plr.Character

    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = plr.Character.HumanoidRootPart
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 4, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = plr.Character

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text .. " [" .. plr.Name .. "]"
    label.TextColor3 = color
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0.7
    label.Parent = billboard
end

local function updateESP()
    -- Clean all ESP
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            for _, v in ipairs(plr.Character:GetChildren()) do
                if v:IsA("Highlight") or v:IsA("BillboardGui") then
                    v:Destroy()
                end
            end
        end
    end

    if not espEnabled then return end

    getRoles()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local color = Color3.fromRGB(255, 255, 255)
            local label = "Innocent"
            
            if plr == murderer then
                color = Color3.fromRGB(255, 0, 0)
                label = "Murderer"
            elseif plr == sheriff then
                color = Color3.fromRGB(0, 150, 255)
                label = "Sheriff"
            end
            
            createESP(plr, color, label)
        end
    end
end

-- Fly Functions
local function StartFly()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local root = character.HumanoidRootPart
    local humanoid = character:FindFirstChild("Humanoid")

    if flyBodyVelocity then flyBodyVelocity:Destroy() end
    if flyBodyGyro then flyBodyGyro:Destroy() end

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.Name = "FlyVelocity"
    flyBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyBodyVelocity.Velocity = Vector3.new(0,0,0)
    flyBodyVelocity.Parent = root

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.Name = "FlyGyro"
    flyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyBodyGyro.P = 10000
    flyBodyGyro.D = 500
    flyBodyGyro.Parent = root

    if humanoid then humanoid.PlatformStand = true end
end

local function EndFly()
    if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
    local humanoid = player.Character and player.Character:FindFirstChild("Humanoid")
    if humanoid then humanoid.PlatformStand = false end
end

-- Tabs
local tabMain = window:AddTab("Main")
local tabCombat = window:AddTab("Combat")
local tabVisuals = window:AddTab("Visuals")
local tabMovement = window:AddTab("Movement")
local tabMisc = window:AddTab("Misc")

