-- ====================== FUNCTIONS ======================
function startGame()
    if GameState.isGameActive then
        library:Notification("Error", "Game already running!", 3)
        return
    end
    GameState.isGameActive = true
    GameState.currentRound += 1
    PlayerData.alive = true

    assignRoles()
    StatusLabel.Text = "Status: In Game"
    RoundsLabel.Text = "Rounds Played: " .. GameState.currentRound

    library:Notification("Game", "Round " .. GameState.currentRound .. " Started!", 4)
    startTimer()
end

function endGame()
    if not GameState.isGameActive then return end
    GameState.isGameActive = false
    StatusLabel.Text = "Status: Ended"

    local reward = (PlayerData.role == "Murderer" and 200) or (PlayerData.role == "Sheriff" and 150) or 50
    PlayerData.coins += reward
    updateStats()

    library:Notification("Game Ended", "+" .. reward .. " Coins", 5)
end

function assignRoles()
    local roles = {"Innocent", "Sheriff", "Murderer"}
    PlayerData.role = roles[math.random(#roles)]
    RoleLabel.Text = "Current Role: " .. PlayerData.role
    library:Notification("Role", "You are " .. PlayerData.role .. "!", 5)
end

function startTimer()
    spawn(function()
        local timeLeft = GameState.roundTime
        while timeLeft > 0 and GameState.isGameActive do
            local m = math.floor(timeLeft / 60)
            local s = timeLeft % 60
            TimeLabel.Text = string.format("Time Left: %02d:%02d", m, s)
            wait(1)
            timeLeft -= 1
        end
        if GameState.isGameActive then endGame() end
    end)
end

function updateStats()
    CoinsLabel.Text = "Coins: " .. PlayerData.coins
    RoundsLabel.Text = "Rounds Played: " .. GameState.currentRound
    local w = {}
    if PlayerData.hasKnife then table.insert(w, "Knife") end
    if PlayerData.hasGun then table.insert(w, "Gun") end
    WeaponLabel.Text = "Weapons: " .. (#w > 0 and table.concat(w, ", ") or "None")
end

function giveWeapon(typ)
    if typ == "Knife" then PlayerData.hasKnife = true
    elseif typ == "Gun" then PlayerData.hasGun = true end
    updateStats()
    library:Notification("Weapon", typ .. " obtained!", 3)
end

function startAutoKill()
    spawn(function()
        while GameState.autoKillEnabled do
            if PlayerData.hasKnife or PlayerData.hasGun then
                local target = findTarget()
                if target then killPlayer(target) end
            end
            wait(0.5)
        end
    end)
end

function findTarget()
    local closest, target = math.huge, nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            if GameState.autoKillTarget == "Nearest Player" then
                local dist = (plr.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if dist < closest then closest, target = dist, plr end
            elseif GameState.autoKillTarget == "Random" then
                return plr
            elseif GameState.autoKillTarget == "Everyone" then
                return plr
            end
        end
    end
    return target
end

function killPlayer(target)
    if target and target.Character and target.Character:FindFirstChild("Humanoid") then
        library:Notification("Kill", "Killed " .. target.Name, 2)
        -- Put your real kill method here
    end
end

function instantKill()
    local t = findTarget()
    if t then killPlayer(t) else library:Notification("Error", "No target found", 3) end
end

-- Teleport functions (same as before)
function teleportToLobby()
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame = CFrame.new(0, 50, 0)
        library:Notification("Teleport", "→ Lobby", 2)
    end
end

function teleportToMap(map)
    local pos = {Map1 = CFrame.new(100,50,100), Map2 = CFrame.new(200,50,200), Map3 = CFrame.new(300,50,300)}
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and pos[map] then
        player.Character.HumanoidRootPart.CFrame = pos[map]
        library:Notification("Teleport", "→ " .. map, 2)
    end
end

function teleportToPlayer(name)
    local target = Players:FindFirstChild(name)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame
        library:Notification("Teleport", "→ " .. name, 2)
    else
        library:Notification("Error", "Player not found", 3)
    end
end

function giveAllItems()
    PlayerData.hasKnife = true
    PlayerData.hasGun = true
    PlayerData.coins += 50000
    updateStats()
    library:Notification("Inventory", "All items given!", 3)
end

function giveAllWeapons()
    PlayerData.hasKnife = true
    PlayerData.hasGun = true
    updateStats()
    library:Notification("Inventory", "All weapons given!", 3)
end

function giveSpecificItem(item)
    library:Notification("Item", item .. " obtained!", 2)
end

function setGodMode(enabled)
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        local h = player.Character.Humanoid
        if enabled then
            h.MaxHealth = math.huge
            h.Health = math.huge
            library:Notification("God Mode", "Enabled", 3)
        else
            h.MaxHealth = 100
            h.Health = 100
            library:Notification("God Mode", "Disabled", 3)
        end
    end
end

