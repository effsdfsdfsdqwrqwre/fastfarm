if getgenv().AutoServerHopLoaded then return end
getgenv().AutoServerHopLoaded = true

local AutoServerHopEnabled = true
local ServerHopInterval = 75
local TargetTimeout = 3
local AttackInterval = 0.1

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local LastServerHop = os.clock()

local function GetCharacter(player)
    return player and player.Character
end

local function GetHumanoid(player)
    local character = GetCharacter(player)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(player)
    local humanoid = GetHumanoid(player)
    return humanoid ~= nil and humanoid.Health > 0
end

local function GetPunch()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end

    return character:FindFirstChild("Punch")
        or LocalPlayer.Backpack:FindFirstChild("Punch")
end

local function Punch()
    local tool = GetPunch()
    if not tool then
        return
    end

    local character = LocalPlayer.Character

    if tool.Parent ~= character then
        tool.Parent = character
    end

    pcall(function()
        tool:Activate()
    end)
end

local function AttackPlayer(player)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root or not IsAlive(player) then
        return
    end

    local startTime = os.clock()

    while AutoServerHopEnabled
        and IsAlive(player)
        and (os.clock() - startTime) < TargetTimeout do

        character = LocalPlayer.Character
        root = character and character:FindFirstChild("HumanoidRootPart")

        local targetCharacter = GetCharacter(player)
        local targetRoot = targetCharacter
            and targetCharacter:FindFirstChild("HumanoidRootPart")

        if not root or not targetRoot then
            break
        end

        root.CFrame = targetRoot.CFrame * CFrame.new(0, 1, 1)


        Punch()

        task.wait(AttackInterval)
    end
end

local function VisitPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if not AutoServerHopEnabled then
            break
        end

        if player ~= LocalPlayer and IsAlive(player) then
            AttackPlayer(player)
        end
    end
end

local function ServerHop()
    local placeId = game.PlaceId
    local myJobId = game.JobId

    for attempt = 1, 6 do
        local success, response = pcall(function()
            return HttpService:JSONDecode(
                game:HttpGet(
                    "https://games.roblox.com/v1/games/"
                    .. placeId
                    .. "/servers/Public?sortOrder=Desc&limit=100"
                )
            )
        end)

        if not success or not response or not response.data then
            task.wait(2 + attempt)
            continue
        end

        local candidates = {}

        for _, srv in response.data do
            if srv.id == myJobId then
                continue
            end

            if srv.playing >= srv.maxPlayers then
                continue
            end

            if srv.playing < 8 then
                continue
            end

            local fill = srv.playing / srv.maxPlayers

            if fill > 0.25 and fill < 0.9 then
                table.insert(candidates, srv)
            end
        end

        if #candidates == 0 then
            task.wait(3 + attempt * 1.5)
            continue
        end

        local target = candidates[math.random(1, #candidates)]

        local successTeleport = pcall(function()
            TeleportService:TeleportToPlaceInstance(
                placeId,
                target.id,
                LocalPlayer
            )
        end)

        if successTeleport then
            return
        end

        task.wait(5 + attempt * 2)
    end
end

task.spawn(function()
    task.wait(2)

    while AutoServerHopEnabled do
        VisitPlayers()
        task.wait(1)
    end
end)

while AutoServerHopEnabled do
    if os.clock() - LastServerHop >= ServerHopInterval then
        LastServerHop = os.clock()

        task.spawn(ServerHop)
    end

    task.wait(1)
end
