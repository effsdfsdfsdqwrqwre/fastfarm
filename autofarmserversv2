local RETELEPORT_TIME = 0
local TARGET_TIMEOUT = 8
local TELEPORT_OFFSET = Vector3.new(0, -4, 0.5)
local SAFE_ZONE_POS = Vector3.new(-3.24319363, 32.9251213, -1270.24817)
local SAFE_ZONE_RADIUS = 300

getgenv().Whitelist = getgenv().Whitelist or {}
getgenv().TeleportEnabled = true

local function isWhitelisted(plr)
	return table.find(getgenv().Whitelist, plr.Name) ~= nil
end

local function isInSafeZone(rootPart)
	if not rootPart then return false end
	return (rootPart.Position - SAFE_ZONE_POS).Magnitude <= SAFE_ZONE_RADIUS
end

local function getPunchTool()
	local char = LocalPlayer.Character
	local backpack = LocalPlayer.Backpack
	return (char and char:FindFirstChild("Punch")) or (backpack and backpack:FindFirstChild("Punch"))
end

task.spawn(function()
	while getgenv().TeleportEnabled do
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr == LocalPlayer then continue end
			if isWhitelisted(plr) then continue end
			if not getgenv().TeleportEnabled then break end

			local start = tick()
			while getgenv().TeleportEnabled
				and plr.Parent
				and tick() - start < TARGET_TIMEOUT do

				local targetChar = plr.Character
				local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
				local targetHumanoid = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
				local myChar = LocalPlayer.Character
				local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
				local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")

				if not targetHumanoid or targetHumanoid.Health <= 0 then
					break
				end

				if isInSafeZone(targetRoot) then
					break
				end

				if targetRoot and myRoot then
					myRoot.CFrame = targetRoot.CFrame * CFrame.new(TELEPORT_OFFSET)
				end

				local punch = getPunchTool()
				if punch and myHumanoid then
					if punch.Parent ~= myChar then
						myHumanoid:EquipTool(punch)
					end
					punch:Activate()
				end

				if RETELEPORT_TIME > 0 then
					task.wait(RETELEPORT_TIME)
				else
					task.wait()
				end
			end
		end
		task.wait()
	end
end)


local function ServerHop()
	local placeId = game.PlaceId
	local myJobId = game.JobId

	for attempt = 1, 8 do
		local success, response = pcall(function()
			return HttpService:JSONDecode(
				game:HttpGet(
					"https://games.roblox.com/v1/games/"
					.. placeId
					.. "/servers/Public?sortOrder=Desc&limit=100"
				)
			)
		end)

		if not success or not response or not response.data then
			task.wait(1 + attempt)
			continue
		end

		local candidates = {}
		for _, srv in ipairs(response.data) do
			if srv.id ~= myJobId
				and srv.playing < srv.maxPlayers
				and srv.playing >= 5 then
				table.insert(candidates, srv)
			end
		end

		if #candidates > 0 then
			local target = candidates[math.random(1, #candidates)]
			local ok = pcall(function()
				TeleportService:TeleportToPlaceInstance(placeId, target.id, LocalPlayer)
			end)
			if ok then
				return
			end
		end

		task.wait(2 + attempt)
	end
end

task.spawn(function()
	while true do
		task.wait(30)
		task.spawn(ServerHop)
	end
end)
