local hideSwitch = tab:AddSwitch("Hide Character", function(bool)
    local character = game.Players.LocalPlayer.Character
    if not character then return end

    for _, v in pairs(character:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Decal") or v:IsA("Texture") then
            if bool then
                if not v:GetAttribute("OriginalTransparency") then
                    v:SetAttribute("OriginalTransparency", v.Transparency)
                end
                v.Transparency = 1
            else
                local original = v:GetAttribute("OriginalTransparency")
                v.Transparency = original or 0
            end
        end
    end
end)
hideSwitch:Set(true)

